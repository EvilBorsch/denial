#!/usr/bin/env bash
# Repack Denial's signed denial_0.6.8-1_arm64.deb with a shell bundle from
# tools/eb-build-shell and, if given, a deniald from tools/eb-build-deniald and
# a Settings from tools/eb-build-settings: only
# /usr/lib/denial/flutter/lib/libapp.so, /usr/lib/denial/flutter/data/flutter_assets,
# /usr/bin/deniald and /usr/lib/denial-apps/settings change, and
# /usr/bin/denial-portal with EB_PORTAL=path (built with deniald by
# tools/eb-build-deniald: the two speak one portal protocol, so a portal comes
# only with its deniald). denialctl, the polkit agent, Settings' Wi-Fi country
# helper and the conffiles stay the release's, the postinst also gives deniald CAP_SYS_NICE (see
# below), and the package still depends on the release's
# denial-flutter-engine (= 0.6.8-1). Its libc6 and libinput10 dependencies
# rise to the newest symbol versions the new binaries import. See
# docs/EB-BUILD.md.
#
# Usage: [EB_PORTAL=DENIAL_PORTAL] tools/eb-repack-deb BUNDLE_DIRECTORY VERSION OUTPUT_DIRECTORY [DENIALD [SETTINGS]]
#   e.g. tools/eb-repack-deb ~/work-denial-shell/out 0.6.8-1+eb1 ~/debs
#   DENIALD may be '' to keep the release's deniald with a new SETTINGS.
set -euo pipefail

USAGE='usage: eb-repack-deb BUNDLE_DIRECTORY VERSION OUTPUT_DIRECTORY [DENIALD [SETTINGS]]'
BUNDLE="${1:?$USAGE}"
VERSION="${2:?$USAGE}"
OUTPUT="${3:?$USAGE}"
DENIALD="${4:-}"
SETTINGS="${5:-}"
PORTAL="${EB_PORTAL:-}"
WORK="${EB_WORK:-$HOME/work-denial-shell}"
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=tools/lib/denial-architecture.sh
. "$ROOT/tools/lib/denial-architecture.sh"

DEB=denial_0.6.8-1_arm64.deb
URL="https://github.com/denialwm/denial/releases/download/v0.6.8/$DEB"
# From the v0.6.8 SHA256SUMS signed by the Denial release key.
SHA256=60ef61ec0d1e80def0420c0490bf9ff45ab53966317a96120dda8b3e1279d4ae
MAINTAINER='EvilBorsch <44337169+EvilBorsch@users.noreply.github.com>'

die() { printf 'eb-repack-deb: %s\n' "$*" >&2; exit 1; }
[[ "$VERSION" == 0.6.8-1+* ]] || die 'VERSION must be 0.6.8-1+SUFFIX, newer than the release'
[[ -f "$BUNDLE/lib/libapp.so" && -d "$BUNDLE/data/flutter_assets" ]] \
    || die "not a shell bundle: $BUNDLE"
if [[ -n "$DENIALD" ]]; then
    [[ -f "$DENIALD" && "$(denial_elf_arch "$DENIALD")" == aarch64 ]] \
        || die "not an aarch64 deniald: $DENIALD"
fi
if [[ -n "$PORTAL" ]]; then
    [[ -n "$DENIALD" ]] || die 'EB_PORTAL needs the deniald built with it'
    [[ -f "$PORTAL" && "$(denial_elf_arch "$PORTAL")" == aarch64 ]] \
        || die "not an aarch64 denial-portal: $PORTAL"
fi
settings_revision=''
if [[ -n "$SETTINGS" ]]; then
    [[ -f "$SETTINGS" && "$(denial_elf_arch "$SETTINGS")" == aarch64 ]] \
        || die "not an aarch64 Settings: $SETTINGS"
    # tools/eb-build-settings writes settings.txt beside it: the package
    # names the denial-apps commit the binary was built from.
    report="$(dirname -- "$SETTINGS")/settings.txt"
    [[ -f "$report" ]] || die "no settings.txt beside $SETTINGS; build it with tools/eb-build-settings"
    settings_revision="$(sed -n 's/^denial-apps: \([0-9a-f]\{40\}\)$/\1/p' "$report")"
    [[ -n "$settings_revision" ]] \
        || die "$report names no denial-apps commit without uncommitted changes"
    grep -qx "  sha256: $(sha256sum "$SETTINGS" | cut -d' ' -f1)" "$report" \
        || die "$SETTINGS is not the binary $report describes"
fi
if [[ -n "$DENIALD$SETTINGS" ]]; then
    command -v aarch64-linux-gnu-objdump >/dev/null \
        || die 'aarch64-linux-gnu-objdump (binutils-aarch64-linux-gnu) is required'
fi

mkdir -p -- "$WORK/dl" "$OUTPUT"
if [[ ! -s "$WORK/dl/$DEB" ]]; then
    curl -fL --retry 3 -o "$WORK/dl/$DEB.part" "$URL"
    mv -- "$WORK/dl/$DEB.part" "$WORK/dl/$DEB"
fi
[[ "$(sha256sum "$WORK/dl/$DEB" | cut -d' ' -f1)" == "$SHA256" ]] \
    || die "$WORK/dl/$DEB does not match its pinned SHA-256"

stage="$(mktemp -d "$WORK/repack.XXXXXX")"
trap 'rm -rf --one-file-system -- "$stage"' EXIT
dpkg-deb -R "$WORK/dl/$DEB" "$stage/denial"
flutter="$stage/denial/usr/lib/denial/flutter"
install -m755 -- "$BUNDLE/lib/libapp.so" "$flutter/lib/libapp.so"
rm -rf -- "$flutter/data/flutter_assets"
cp -a -- "$BUNDLE/data/flutter_assets" "$flutter/data/flutter_assets"
chmod -R u=rwX,go=rX -- "$flutter/data/flutter_assets"
glibc_needed=''
libinput_needed=''
replaced=()
if [[ -n "$DENIALD" ]]; then
    install -m755 -- "$DENIALD" "$stage/denial/usr/bin/deniald"
    replaced+=("$DENIALD")
fi
if [[ -n "$PORTAL" ]]; then
    install -m755 -- "$PORTAL" "$stage/denial/usr/bin/denial-portal"
    replaced+=("$PORTAL")
fi
if [[ -n "$SETTINGS" ]]; then
    [[ -f "$stage/denial/usr/lib/denial-apps/settings" ]] \
        || die 'the release package has no /usr/lib/denial-apps/settings'
    install -m755 -- "$SETTINGS" "$stage/denial/usr/lib/denial-apps/settings"
    replaced+=("$SETTINGS")
fi
if ((${#replaced[@]})); then
    # The newest glibc symbol version they need: built against another root
    # than the release's, they may need a newer libc than the package names.
    glibc_needed="$(aarch64-linux-gnu-objdump -T "${replaced[@]}" \
        | grep -o 'GLIBC_[0-9.]*' | sed 's/^GLIBC_//' | sort -V | tail -1)"
    # Likewise libinput: libinput names each symbol version after the release
    # that brought it (LIBINPUT_1.26 for the clickfinger button map, which the
    # touchpad's two-finger click sets), and the release's package depends on
    # libinput10 without a version. grep finds none in a binary that does not
    # link libinput.
    libinput_needed="$(aarch64-linux-gnu-objdump -T "${replaced[@]}" \
        | { grep -o 'LIBINPUT_[0-9.]*' || true; } | sed 's/^LIBINPUT_//' | sort -V | tail -1)"
fi

# Under a display manager deniald runs as the user and cannot raise its
# render threads' priority or ask for a CPU floor, which Denial Linux grants
# through its service (AmbientCapabilities=CAP_SYS_NICE): without it frames
# stutter. Give the binary the file capability, as KWin does.
postinst="$stage/denial/DEBIAN/postinst"
python3 -I - "$postinst" <<'PY2'
import sys
path = sys.argv[1]
s = open(path).read()
block = """    if command -v setcap >/dev/null 2>&1; then
      setcap cap_sys_nice+ep /usr/bin/deniald || true
    fi
"""
anchor = "  configure|abort-upgrade|abort-deconfigure|abort-remove)\n"
assert s.count(anchor) == 1, 'postinst layout changed'
s = s.replace(anchor, anchor + block)
open(path, 'w').write(s)
PY2

control="$stage/denial/DEBIAN/control"
python3 -I - "$control" "$VERSION" "$MAINTAINER" "$(git -C "$ROOT" rev-parse HEAD)" \
    "$glibc_needed" "$DENIALD" "$settings_revision" "${PORTAL:+portal}" "$libinput_needed" <<'PY'
import re
import sys
import textwrap
path, version, maintainer, revision, glibc, deniald, settings, portal, libinput = sys.argv[1:10]


def newer(a, b):
    return [int(x) for x in a.split('.')] > [int(x) for x in b.split('.')]


lines = open(path).read().splitlines()
out = []
for line in lines:
    if line.startswith('Version: '):
        line = 'Version: ' + version
    elif line.startswith('Maintainer: '):
        line = 'Maintainer: ' + maintainer
    elif line.startswith('Installed-Size: '):
        continue
    elif line.startswith('Depends: '):
        match = re.search(r'libc6 \(>= ([0-9.]+)\)', line)
        assert match, 'Depends has no libc6 version'
        if glibc and newer(glibc, match.group(1)):
            line = line.replace(match.group(0), 'libc6 (>= ' + glibc + ')')
        if libinput:
            match = re.search(r'(?<![\w.+-])libinput10(?: \(>= ([0-9.]+)\))?(?=,|$)', line)
            assert match, 'Depends has no libinput10'
            if match.group(1) is None or newer(libinput, match.group(1)):
                line = line.replace(match.group(0), 'libinput10 (>= ' + libinput + ')')
        line = line + ', libcap2-bin'
        out.append(line)
        # deniald is the session's notification server
        # (org.freedesktop.Notifications) and denial-polkit-agent its polkit
        # agent. Ubuntu packages that need one of either (update-notifier,
        # update-manager, nm-connection-editor) are satisfied by GNOME Shell
        # otherwise; without it APT would install notification-daemon, which
        # would compete for the bus name, and policykit-1-gnome.
        assert not any(l.startswith('Provides: ') for l in lines), 'release has Provides'
        out.append('Provides: notification-daemon, polkit-1-auth-agent')
        continue
    out.append(line)
out.append(' .')
if settings:
    parts = 'the Flutter shell (libapp.so, flutter_assets)'
    if portal:
        parts += ', deniald, denial-portal and Settings'
        built = 'the shell, deniald and denial-portal'
    elif deniald:
        parts += ', deniald and Settings'
        built = 'the shell and deniald'
    else:
        parts += ' and Settings'
        built = 'the shell'
    text = ('This build replaces ' + parts + ' of the signed 0.6.8-1 release: '
            + built + ' built from EvilBorsch/denial ' + revision[:12]
            + ', Settings (/usr/lib/denial-apps/settings) from EvilBorsch/denial-apps '
            + settings[:12] + '.')
    out.extend(' ' + line for line in textwrap.wrap(text, 72))
elif portal:
    out.append(' This build replaces the Flutter shell (libapp.so, flutter_assets),')
    out.append(' deniald and denial-portal of the signed 0.6.8-1 release, built from')
    out.append(' EvilBorsch/denial ' + revision[:12] + '.')
elif deniald:
    out.append(' This build replaces the Flutter shell (libapp.so, flutter_assets) and')
    out.append(' deniald of the signed 0.6.8-1 release, built from EvilBorsch/denial')
    out.append(' ' + revision[:12] + '.')
else:
    out.append(' This build replaces only the Flutter shell (libapp.so, flutter_assets)')
    out.append(' of the signed 0.6.8-1 release, built from EvilBorsch/denial ' + revision[:12] + '.')
open(path, 'w').write('\n'.join(out) + '\n')
PY
size="$(du -sk --apparent-size --exclude=DEBIAN "$stage/denial" | cut -f1)"
sed -i "/^Maintainer: /a Installed-Size: $size" "$control"

epoch="$(git -C "$ROOT" log -1 --format=%ct)"
find "$stage/denial" -print0 | xargs -0 touch --no-dereference --date="@$epoch"
out="$OUTPUT/denial_${VERSION}_arm64.deb"
env SOURCE_DATE_EPOCH="$epoch" dpkg-deb --root-owner-group --uniform-compression -Zxz \
    --build "$stage/denial" "$out" >/dev/null
dpkg-deb -I "$out" | sed -n '/Package:/,$p'
(cd -- "$OUTPUT" && sha256sum "$(basename -- "$out")" | tee "$(basename -- "$out").sha256")
