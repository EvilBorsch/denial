#!/usr/bin/env bash
# Cross-builds deniald for arm64 as the release does (cargo build --locked
# --release --features flutter, default features), against an Ubuntu or Arch
# Linux ARM root, and runs its tests under qemu-aarch64 with that root.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=tools/lib/denial-architecture.sh
. "$SCRIPT_DIR/lib/denial-architecture.sh"

usage() {
    cat >&2 <<USAGE
Usage: $0 build SYSROOT OUT_DIR
       $0 test SYSROOT [cargo test arguments, e.g. -- idle_policy]

build: cargo build --release of deniald for aarch64; copies it to OUT_DIR and
       writes OUT_DIR/deniald.txt with its hash, libraries and GLIBC needs.
test:  cargo test of the deniald binary for aarch64, run under
       qemu-aarch64 -L SYSROOT.

EB_WORK (default ~/work-denial-deniald) holds the Cargo target directory,
EB_JOBS (default 8) the job count. The binary reports eb.g<commit> as its
build (deniald --version); EB_BUILD_IDENTITY overrides that.
USAGE
    exit 2
}

[[ $# -ge 2 ]] || usage
MODE="$1"
SYSROOT="$(realpath -- "$2")"
shift 2
WORK="${EB_WORK:-$HOME/work-denial-deniald}"
JOBS="${EB_JOBS:-8}"

if [[ -f "$HOME/.cargo/env" ]]; then
    # shellcheck source=/dev/null
    . "$HOME/.cargo/env"
fi
command -v cargo >/dev/null || { printf 'cargo (rustup) is required\n' >&2; exit 1; }

DENIAL_ARM64_SYSROOT="$SYSROOT"
export DENIAL_ARM64_SYSROOT
denial_arch_configure aarch64
denial_cross_configure_rust
export CARGO_TARGET_DIR="$WORK/target"
mkdir -p "$CARGO_TARGET_DIR"
# The release compiles main.g<commit> in; this names the fork's commit.
identity="eb.g$(git -C "$ROOT" rev-parse HEAD)"
if [[ -n "$(git -C "$ROOT" status --porcelain --untracked-files=no)" ]]; then
    identity="$identity.dirty"
fi
export DENIAL_BUILD_VERSION="${EB_BUILD_IDENTITY:-$identity}"

pkg-config --exists libdrm gbm egl libinput libseat libudev xkbcommon \
    || { printf 'the root lacks a -dev package deniald needs\n' >&2; exit 1; }

cd -- "$ROOT/compositor"
case "$MODE" in
    build)
        [[ $# -eq 1 ]] || usage
        OUT="$1"
        cargo build \
            --locked \
            --release \
            --jobs "$JOBS" \
            --target "$DENIAL_RUST_TARGET" \
            --features flutter \
            --bin deniald
        binary="$CARGO_TARGET_DIR/$DENIAL_RUST_TARGET/release/deniald"
        [[ "$(denial_elf_arch "$binary")" == aarch64 ]]
        mkdir -p "$OUT"
        install -m755 "$binary" "$OUT/deniald"
        {
            printf 'build identity: %s\n' "$DENIAL_BUILD_VERSION"
            printf 'rustc: %s\n' "$(rustc --version)"
            printf 'sysroot: %s\n' "$SYSROOT"
            printf 'sha256: %s\n' "$(sha256sum "$OUT/deniald" | cut -d' ' -f1)"
            printf '\nNEEDED:\n'
            aarch64-linux-gnu-objdump -p "$OUT/deniald" | awk '$1 == "NEEDED" { print "  " $2 }'
            printf '\nversioned symbol needs:\n'
            aarch64-linux-gnu-objdump -T "$OUT/deniald" \
                | grep -o '(GLIBC_[0-9.]*)\|(GCC_[0-9.]*)' | tr -d '()' | sort -uV | sed 's/^/  /'
        } > "$OUT/deniald.txt"
        cat "$OUT/deniald.txt"
        ;;
    test)
        command -v qemu-aarch64 >/dev/null || { printf 'qemu-aarch64 is required\n' >&2; exit 1; }
        export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUNNER="qemu-aarch64 -L $SYSROOT"
        cargo test \
            --locked \
            --jobs "$JOBS" \
            --target "$DENIAL_RUST_TARGET" \
            --features flutter \
            --bin deniald \
            "$@"
        ;;
    *)
        usage
        ;;
esac
