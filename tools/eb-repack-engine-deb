#!/usr/bin/env bash
# ?????????????? ??????????? ????? ?????? Denial ? libflutter_engine.so,
# ????????? ?? EvilBorsch/flutter. ????????? ABI ? ????????????? ?????? Dart.
#
# tools/eb-repack-engine-deb ENGINE_SO VERSION OUTPUT_DIRECTORY FLUTTER_COMMIT
set -euo pipefail

USAGE='usage: eb-repack-engine-deb ENGINE_SO VERSION OUTPUT_DIRECTORY FLUTTER_COMMIT'
ENGINE="${1:?$USAGE}"
VERSION="${2:?$USAGE}"
OUTPUT="${3:?$USAGE}"
COMMIT="${4:?$USAGE}"
WORK="${EB_WORK:-$HOME/work-denial-shell}"
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=tools/lib/denial-architecture.sh
. "$ROOT/tools/lib/denial-architecture.sh"

RELEASE=0.6.10
BASE_VERSION="$RELEASE-1"
DEB="denial-flutter-engine_${BASE_VERSION}_arm64.deb"
URL="https://github.com/denialwm/denial/releases/download/v$RELEASE/$DEB"
# From the v0.6.10 SHA256SUMS signed by the Denial release key.
SHA256=74e777d3f9914330ba07d8a8f96fb2d33fa1c0997bf6220bcb77cf05cc713141
MAINTAINER='EvilBorsch <44337169+EvilBorsch@users.noreply.github.com>'
# The Dart VM snapshot identity of the release engine: an AOT shell built for
# the release loads only into an engine that carries it.
SNAPSHOT=0451907c2eaa8467e848c0067bfe8ed4

die() { printf 'eb-repack-engine-deb: %s\n' "$*" >&2; exit 1; }
[[ "$VERSION" == "$BASE_VERSION"+* ]] || die "VERSION must be $BASE_VERSION+SUFFIX, newer than the release"
[[ -f "$ENGINE" && "$(denial_elf_arch "$ENGINE")" == aarch64 ]] \
    || die "not an aarch64 engine: $ENGINE"
grep -q "$SNAPSHOT" "$ENGINE" || die "$ENGINE lacks the release's snapshot identity $SNAPSHOT"
[[ "$COMMIT" =~ ^[0-9a-f]{7,40}$ ]] || die "not a commit: $COMMIT"

mkdir -p -- "$WORK/dl" "$OUTPUT"
if [[ ! -s "$WORK/dl/$DEB" ]]; then
    curl -fL --retry 3 -o "$WORK/dl/$DEB.part" "$URL"
    mv -- "$WORK/dl/$DEB.part" "$WORK/dl/$DEB"
fi
[[ "$(sha256sum "$WORK/dl/$DEB" | cut -d' ' -f1)" == "$SHA256" ]] \
    || die "$WORK/dl/$DEB does not match its pinned SHA-256"

stage="$(mktemp -d "$WORK/repack-engine.XXXXXX")"
trap 'rm -rf --one-file-system -- "$stage"' EXIT
dpkg-deb -R "$WORK/dl/$DEB" "$stage/engine"
install -m644 -- "$ENGINE" "$stage/engine/usr/lib/denial/flutter/lib/libflutter_engine.so"
control="$stage/engine/DEBIAN/control"
size="$(du -sk --exclude=DEBIAN "$stage/engine" | cut -f1)"
sed -i -e "s/^Version: .*/Version: $VERSION/" \
    -e "s/^Maintainer: .*/Maintainer: $MAINTAINER/" \
    -e "s/^Installed-Size: .*/Installed-Size: $size/" "$control"
cat >> "$control" <<EOF2
 .
 This build replaces libflutter_engine.so of the signed $BASE_VERSION release with
 one built from EvilBorsch/flutter $COMMIT; the embedder ABI and the Dart
 snapshot identity are the release's.
EOF2
dpkg-deb --root-owner-group -Zxz -b "$stage/engine" "$OUTPUT/denial-flutter-engine_${VERSION}_arm64.deb" >/dev/null
echo "$OUTPUT/denial-flutter-engine_${VERSION}_arm64.deb"
